# Todoist API (required for tests). Get token: https://app.todoist.com/app/settings/integrations
TODOIST_API_KEY=

# Optional. Default from official REST v2 docs: https://developer.todoist.com/rest/v2/
TODOIST_BASE_URL=https://api.todoist.com/rest/v2

# Optional; for Discord reporter
DISCORD_WEBHOOK_URL=
