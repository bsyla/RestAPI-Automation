{
  "name": "restapi-automation",
  "version": "1.0.0",
  "description": "Todoist REST API test automation — Projects & Tasks CRUD, negative scenarios, Mochawesome reports, GitHub Actions CI",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:all",
    "test:all": "mocha 'tests/scenarios/all.js' --reporter mochawesome --timeout 20000",
    "test:projects": "mocha 'tests/scenarios/projectCRUD.js' --reporter mochawesome --timeout 20000",
    "test:tasks": "mocha 'tests/scenarios/taskCRUD.js' --reporter mochawesome --timeout 20000",
    "projects-discord": "mocha 'tests/scenarios/projectCRUD.js' --reporter mocha-multi-reporters --reporterOptions configFile=config.json --timeout 20000"
  },
  "author": "",
  "license": "ISC",
  "keywords": [
    "todoist",
    "api",
    "rest",
    "automation",
    "mocha",
    "chai",
    "supertest",
    "testing",
    "sdet"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "chai": "^5.1.1",
    "mocha": "^10.4.0",
    "supertest": "^7.0.0"
  },
  "dependencies": {
    "@doist/todoist-api-typescript": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "get-nested-value": "^1.0.3",
    "mocha-multi-reporters": "^1.5.1",
    "mochawesome": "^7.1.3"
  },
  "type": "module"
}
